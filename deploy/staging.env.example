# Salin menjadi deploy/staging.env (JANGAN di-commit), isi, lalu:
#   cd deploy && docker compose -f docker-compose.staging.yml --env-file staging.env up -d --build

# ---- Domain & HTTPS (dibaca docker compose / Caddy) ---------------------------
STAGING_DOMAIN=staging.kantoranda.id
ACME_EMAIL=it@kantoranda.id
# Sandi pelindung seluruh situs staging. Buat hash dengan:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'sandi-penguji'
# Tempel hasilnya DI DALAM TANDA KUTIP TUNGGAL (karena berisi karakter $).
STAGING_BASIC_AUTH_USER=penguji
STAGING_BASIC_AUTH_HASH='$2a$14$GANTI_DENGAN_HASH_DARI_PERINTAH_DI_ATAS'
# ATAU (untuk deploy via GitHub Actions): isi sandi biasa di bawah dan hapus baris HASH di atas —
# hash dibuat otomatis di server dan sandi teks biasa tidak disimpan di server.
# STAGING_BASIC_AUTH_PASSWORD='sandi-penguji'

# ---- Aplikasi -------------------------------------------------------------------
PUBLIC_URL=https://staging.kantoranda.id
TZ_OFFICE=Asia/Jakarta
ADMIN_USERNAME=admin
# Kata sandi admin awal (ganti setelah login pertama) — atau kosongkan untuk dicetak di log
ADMIN_PASSWORD=
# Kosongkan: dibuat acak otomatis
SESSION_SECRET=

# Staging hanya mengirim pesan ke: akun staf aktif, grup Telegram, dan daftar di bawah.
# Format: email, "@domain" (semua alamat di domain itu), atau nomor WA. Dipisah koma.
STAGING_ALLOWED_RECIPIENTS=@kantoranda.id,081200000000

# ---- Gmail (gunakan kotak masuk KHUSUS staging, bukan inbox produksi) --------------
EMAIL_PROVIDER=gmail
GMAIL_USER=intake-staging@kantoranda.id
GMAIL_APP_PASSWORD=
MAIL_FROM="Kantor Hukum (STAGING) <intake-staging@kantoranda.id>"
OFFICE_DOMAIN=kantoranda.id

# ---- WhatsApp Cloud API ------------------------------------------------------------
# Disarankan memakai nomor uji (test number) Meta untuk staging.
WA_PROVIDER=meta
WA_META_TOKEN=
WA_META_PHONE_NUMBER_ID=
WA_META_MODE=auto
WA_META_TEMPLATE_NAME=notifikasi_kantor
WA_META_TEMPLATE_LANG=id
# Teks acak bebas (mis. hasil `openssl rand -hex 16`), dipakai saat mendaftarkan webhook di Meta
WA_META_VERIFY_TOKEN=
WA_META_APP_SECRET=
WA_NOTIFY_CLIENT=true

# ---- Telegram (grup uji coba) ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# ---- AI ----------------------------------------------------------------------------------
AI_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
