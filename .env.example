# Salin menjadi .env lalu isi. File .env TIDAK boleh di-commit.
# Kanal yang dikosongkan berjalan dalam mode "simulasi" (pesan dicetak ke log server).

# ---- Server -----------------------------------------------------------------
PORT=3000
# Alamat publik aplikasi (dipakai di tautan email/WA). Wajib https di produksi.
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
# true bila di belakang reverse proxy (Nginx, Cloudflare) agar IP klien terbaca benar
TRUST_PROXY=false
TZ_OFFICE=Asia/Jakarta
DATA_DIR=data

# ---- Admin (akun awal) -------------------------------------------------------
# Akun admin pertama dibuat otomatis dari ADMIN_USERNAME. Staf lain dibuat di Panel Admin → Pengguna.
ADMIN_USERNAME=admin
# Disarankan: `npm run set-password -- admin "kata-sandi-panjang"`. Alternatif (dev): ADMIN_PASSWORD=...
# Jika tidak diisi, kata sandi sementara dicetak di terminal saat start pertama.
SESSION_SECRET=
SESSION_HOURS=12

# ---- Email: Gmail / Google Workspace -----------------------------------------
# 1) Aktifkan Verifikasi 2 Langkah di akun Google  2) Buat App Password (myaccount.google.com/apppasswords)
# 3) Pastikan IMAP aktif (Gmail → Setelan → Penerusan dan POP/IMAP).
EMAIL_PROVIDER=gmail
GMAIL_USER=intake@contoh-kantorhukum.id
GMAIL_APP_PASSWORD=
MAIL_FROM="Kantor Hukum Delvos & Rekan <intake@contoh-kantorhukum.id>"
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=60
# Domain email kantor (untuk deteksi pemalsuan pengirim)
OFFICE_DOMAIN=contoh-kantorhukum.id
# (Penyedia lain: kosongkan EMAIL_PROVIDER lalu isi SMTP_HOST/SMTP_PORT/SMTP_SECURE/SMTP_USER/SMTP_PASS
#  dan IMAP_HOST/IMAP_PORT/IMAP_SECURE/IMAP_USER/IMAP_PASS.)

# ---- Penerima notifikasi tim tambahan -------------------------------------------
# Biasanya cukup diatur per akun di Panel Admin → Pengguna (centang Email / WA). Daftar di bawah ditambahkan.
TEAM_EMAILS=
TEAM_WHATSAPP=

# ---- WhatsApp Cloud API (Meta) ---------------------------------------------------
WA_PROVIDER=meta
# Token permanen dari System User di Meta Business Manager (izin whatsapp_business_messaging)
WA_META_TOKEN=
# "Phone number ID" (bukan nomor telepon) dari WhatsApp → API Setup
WA_META_PHONE_NUMBER_ID=
WA_META_API_VERSION=v21.0
# auto = teks biasa bila penerima menghubungi nomor kantor <24 jam terakhir, selain itu template
WA_META_MODE=auto
# Nama & bahasa template utilitas yang sudah disetujui Meta (teks lengkap di README)
WA_META_TEMPLATE_NAME=notifikasi_kantor
WA_META_TEMPLATE_LANG=id
# Webhook: URL {PUBLIC_URL}/webhooks/whatsapp — verify token bebas Anda tentukan; App Secret dari App Settings → Basic
WA_META_VERIFY_TOKEN=
WA_META_APP_SECRET=
# Kirim konfirmasi & update status ke WhatsApp klien
WA_NOTIFY_CLIENT=true
# (Alternatif: WA_PROVIDER=fonnte + FONNTE_TOKEN=..., atau WA_PROVIDER=log untuk simulasi)

# ---- Telegram ---------------------------------------------------------------------
# Buat bot via @BotFather, tambahkan ke grup tim, lalu isi chat id grup (diawali -100...)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# ---- AI (Claude) --------------------------------------------------------------------
# Triase email & ringkasan registrasi untuk tim. Kunci API dari console.anthropic.com.
AI_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- Keamanan ---------------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_UPLOAD_FILES=5
SPAM_THRESHOLD=60
AUTOREPLY_PER_SENDER_PER_DAY=2
SUBMIT_RATE_LIMIT=6
