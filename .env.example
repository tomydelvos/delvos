# Salin menjadi .env lalu isi. File .env TIDAK boleh di-commit.
# Kanal yang dikosongkan berjalan dalam mode "simulasi" (pesan dicetak ke log server).

# ---- Server -----------------------------------------------------------------
PORT=3000
# Alamat publik aplikasi (dipakai di tautan email/WA). Wajib https di produksi.
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
# true bila di belakang reverse proxy (Nginx, Cloudflare) agar IP klien terbaca benar
TRUST_PROXY=false
TZ_OFFICE=Asia/Jakarta
DATA_DIR=data

# ---- Admin ------------------------------------------------------------------
ADMIN_USERNAME=admin
# Disarankan: jalankan `npm run set-password -- "kata-sandi-panjang"` (tersimpan ter-hash di database).
# Alternatif untuk pengembangan saja:
# ADMIN_PASSWORD=ganti-saya
# Rahasia penandatangan sesi (acak, min. 32 karakter). Jika kosong dibuat otomatis.
SESSION_SECRET=
SESSION_HOURS=12

# ---- Email keluar (SMTP) ------------------------------------------------------
# Contoh Gmail/Google Workspace: smtp.gmail.com, port 465, gunakan App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kantor Hukum Delvos & Rekan <intake@contoh-kantorhukum.id>"

# ---- Email masuk (IMAP) — kotak masuk yang menerima email klien ----------------
# Contoh Gmail: imap.gmail.com, port 993. Email yang sudah diproses ditandai "dibaca".
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=60
# Domain email kantor (untuk deteksi pemalsuan pengirim)
OFFICE_DOMAIN=

# ---- Penerima notifikasi tim ---------------------------------------------------
# Dipisah koma
TEAM_EMAILS=
TEAM_WHATSAPP=

# ---- WhatsApp -------------------------------------------------------------------
# log = simulasi | fonnte = https://fonnte.com | meta = WhatsApp Cloud API resmi
WA_PROVIDER=log
FONNTE_TOKEN=
WA_META_TOKEN=
WA_META_PHONE_NUMBER_ID=
WA_META_API_VERSION=v21.0
# Kirim konfirmasi & update status ke WhatsApp klien
WA_NOTIFY_CLIENT=true

# ---- Telegram ---------------------------------------------------------------------
# Buat bot via @BotFather, tambahkan ke grup tim, lalu isi chat id grup (diawali -100...)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# ---- AI (Claude) — opsional ---------------------------------------------------------
# Triase email & ringkasan registrasi untuk tim. Data klien dikirim ke Anthropic API bila aktif.
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- Keamanan ---------------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_UPLOAD_FILES=5
SPAM_THRESHOLD=60
AUTOREPLY_PER_SENDER_PER_DAY=2
SUBMIT_RATE_LIMIT=6
